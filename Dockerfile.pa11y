FROM node:24-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium \
  && rm -rf /var/lib/apt/lists/*

# pa11y-ci pulls in Puppeteer; skip its bundled Chromium download
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN npm install -g pa11y-ci@^4.1.1

WORKDIR /app

ENV BASE_PATH=""
ENTRYPOINT ["sh", "-c", "pa11y-ci --config pa11yci.ci.json --sitemap \"https://dxiopc3hftj5i.cloudfront.net/${BASE_PATH}sitemap.xml\" --sitemap-exclude \"/*.pdf\" --sitemap-find https://bcda.cms.gov/ --sitemap-replace https://dxiopc3hftj5i.cloudfront.net/ --json > pa11y-results.json"]
